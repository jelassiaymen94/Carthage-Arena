<form method="get" class="mb-4">
    <input type="text" name="search" placeholder="Rechercher par nom ou type" value="{{ search }}"
           class="border p-2 rounded">
    <button type="submit" class="bg-primary text-white px-4 py-2 rounded">Rechercher</button>
</form>

<table class="min-w-full bg-white">
    <thead>
        <tr>
            <th>Nom</th>
            <th>Prix</th>
            <th>Stock</th>
            <th>Type</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        {% for merch in merchItems %}
        <tr>
            <td>{{ merch.name }}</td>
            <td>{{ merch.price }}</td>
            <td>{{ merch.stock }}</td>
            <td>{{ merch.type }}</td>
            <td class="flex gap-2">
                <a href="{{ path('admin_merch_edit', {id: merch.id}) }}"
                   class="bg-yellow-500 text-white px-2 py-1 rounded">Modifier</a>
                <form action="{{ path('admin_merch_delete', {id: merch.id}) }}" method="post">
                    <button type="submit" class="bg-red-500 text-white px-2 py-1 rounded"
                            onclick="return confirm('Supprimer ce merch ?');">Supprimer</button>
                </form>
            </td>
        </tr>
        {% endfor %}
    </tbody>
</table>