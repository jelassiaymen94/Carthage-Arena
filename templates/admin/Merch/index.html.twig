{% extends 'base_admin.html.twig' %}
{% block title %}Gestion Merch - Admin{% endblock %}

{% block admin_content %}
<div class="flex flex-col gap-6">
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-bold text-white">Gestion Merch</h1>
            <p class="text-sm text-gray-400 mt-1">Gérez les articles de merchandising de la boutique.</p>
        </div>
        <a href="{{ path('admin_merch_new') }}"
           class="flex items-center gap-2 px-5 py-2.5 rounded-xl bg-primary text-white text-sm font-bold shadow-lg shadow-red-900/20 hover:bg-red-700 transition-all">
            <span class="material-symbols-outlined text-[18px]">add</span>
            Ajouter un Merch
        </a>
    </div>

    {% for message in app.flashes('success') %}
    <div class="rounded-xl bg-green-500/10 border border-green-500/20 px-4 py-3 text-green-400 text-sm font-medium">
        {{ message }}
    </div>
    {% endfor %}

    <div class="rounded-2xl bg-surface-dark border border-white/5 p-6">
        <form method="get" class="mb-6 flex items-center gap-3">
            <div class="relative flex-1 max-w-sm">
                <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-gray-500 text-[18px]">search</span>
                <input type="text" name="search" placeholder="Rechercher par nom ou type..."
                       value="{{ search }}"
                       class="w-full bg-white/5 border border-white/10 rounded-xl pl-10 pr-4 py-2.5 text-sm text-white placeholder-gray-500 focus:border-primary focus:outline-none transition-all">
            </div>
            <button type="submit"
                    class="px-5 py-2.5 rounded-xl bg-primary text-white text-sm font-bold hover:bg-red-700 transition-all">
                Rechercher
            </button>
            {% if search %}
            <a href="{{ path('admin_merch_index') }}"
               class="px-5 py-2.5 rounded-xl bg-white/5 border border-white/10 text-white text-sm font-medium hover:bg-white/10 transition-all">
                Effacer
            </a>
            {% endif %}
        </form>

        <div class="overflow-x-auto">
            <table class="w-full text-sm text-left">
                <thead>
                    <tr class="border-b border-white/10">
                        <th class="px-4 py-3 text-xs font-semibold uppercase tracking-wider text-gray-400">Image</th>
                        <th class="px-4 py-3 text-xs font-semibold uppercase tracking-wider text-gray-400">Nom</th>
                        <th class="px-4 py-3 text-xs font-semibold uppercase tracking-wider text-gray-400">Prix</th>
                        <th class="px-4 py-3 text-xs font-semibold uppercase tracking-wider text-gray-400">Stock</th>
                        <th class="px-4 py-3 text-xs font-semibold uppercase tracking-wider text-gray-400">Type</th>
                        <th class="px-4 py-3 text-xs font-semibold uppercase tracking-wider text-gray-400">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-white/5">
                    {% for merch in merchItems %}
                    <tr class="hover:bg-white/3 transition-colors group">
                        <td class="px-4 py-3">
                            {% if merch.imageUrl %}
                            <img src="{{ merch.imageUrl }}" alt="{{ merch.name }}"
                                 class="w-12 h-12 object-cover rounded-lg border border-white/10">
                            {% else %}
                            <div class="w-12 h-12 rounded-lg border border-white/10 bg-white/5 flex items-center justify-center">
                                <span class="material-symbols-outlined text-gray-600 text-[20px]">image_not_supported</span>
                            </div>
                            {% endif %}
                        </td>
                        <td class="px-4 py-3 font-semibold text-white">{{ merch.name }}</td>
                        <td class="px-4 py-3 text-secondary font-bold">{{ merch.price }} CP</td>
                        <td class="px-4 py-3">
                            <span class="px-2 py-1 rounded-full text-xs font-bold {{ merch.stock > 0 ? 'bg-green-500/10 text-green-400 border border-green-500/20' : 'bg-red-500/10 text-red-400 border border-red-500/20' }}">
                                {{ merch.stock }}
                            </span>
                        </td>
                        <td class="px-4 py-3">
                            <span class="px-2 py-1 rounded-full text-xs font-bold bg-white/5 text-gray-300 border border-white/10">
                                {{ merch.type }}
                            </span>
                        </td>
                        <td class="px-4 py-3">
                            <div class="flex items-center gap-2">
                                <a href="{{ path('admin_merch_edit', {id: merch.id}) }}"
                                   class="flex items-center gap-1 px-3 py-1.5 rounded-lg bg-yellow-500/10 border border-yellow-500/20 text-yellow-400 text-xs font-bold hover:bg-yellow-500/20 transition-colors">
                                    <span class="material-symbols-outlined text-[14px]">edit</span>
                                    Modifier
                                </a>
                                <form action="{{ path('admin_merch_delete', {id: merch.id}) }}" method="post"
                                      onsubmit="return confirm('Supprimer ce merch ?');">
                                    <button type="submit"
                                            class="flex items-center gap-1 px-3 py-1.5 rounded-lg bg-red-500/10 border border-red-500/20 text-red-400 text-xs font-bold hover:bg-red-500/20 transition-colors">
                                        <span class="material-symbols-outlined text-[14px]">delete</span>
                                        Supprimer
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                    {% else %}
                    <tr>
                        <td colspan="6" class="px-4 py-12 text-center text-gray-400">
                            <span class="material-symbols-outlined text-[48px] text-gray-600 block mb-2">inventory_2</span>
                            Aucun merch trouvé.
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}