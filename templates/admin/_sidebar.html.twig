<aside class="fixed top-0 left-0 h-screen w-64 bg-[#161616] border-r border-white/5 flex flex-col z-40">
    {# Logo & Brand #}
    <div class="flex items-center gap-3 px-6 py-5 border-b border-white/5">
        <img src="{{ asset('assets/logo.webp') }}" alt="Carthage Arena" class="h-16 w-auto" />
        <div class="flex flex-col leading-tight">
            <span class="text-xs font-bold tracking-[0.25em] text-white/40 uppercase">Admin</span>
            <span class="text-sm font-black tracking-wider text-primary uppercase">Panel</span>
        </div>
    </div>

    {# Navigation #}
    <nav class="flex-1 overflow-y-auto py-4 px-3">
        <ul class="flex flex-col gap-1">

            {# Existing Links ... #}
            <li>
                <a href="{{ path('admin_dashboard') }}"
                   class="flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-medium transition-all duration-200
                          {{ app.request.get('_route') == 'admin_dashboard' ? 'bg-primary/10 text-primary' : 'text-white/60 hover:text-white hover:bg-white/5' }}">
                    <span class="material-symbols-outlined text-[20px]">dashboard</span>
                    Tableau de Bord
                </a>
            </li>

            {# ... other links ... #}

            {# Boutique / Shop with submenu #}
            <li>
                <a href="{{ path('admin_shop') }}"
                   class="flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-medium transition-all duration-200
                          {{ app.request.get('_route') starts with 'admin_merch' or app.request.get('_route') == 'admin_shop'
                              ? 'bg-primary/10 text-primary'
                              : 'text-white/60 hover:text-white hover:bg-white/5' }}">
                    <span class="material-symbols-outlined text-[20px]">shopping_bag</span>
                    Boutique
                    <span class="material-symbols-outlined ml-auto text-[16px]">expand_more</span>
                </a>
                <ul class="ml-6 mt-1 flex flex-col gap-1">
                    <li>
                        <a href="{{ path('admin_merch_list') }}"
                           class="text-white/60 hover:text-white transition-all duration-200
                                  {{ app.request.get('_route') == 'admin_merch_list' ? 'text-primary font-semibold' : '' }}">
                            Liste Merch
                        </a>
                    </li>
                    <li>
                        <a href="{{ path('admin_merch_new') }}"
                           class="text-white/60 hover:text-white transition-all duration-200
                                  {{ app.request.get('_route') == 'admin_merch_new' ? 'text-primary font-semibold' : '' }}">
                            Ajouter Merch
                        </a>
                    </li>
                    <li>
                        <a href="{{ path('admin_merch_stats') }}"
                           class="text-white/60 hover:text-white transition-all duration-200
                                  {{ app.request.get('_route') == 'admin_merch_stats' ? 'text-primary font-semibold' : '' }}">
                            Top 3 Merch
                        </a>
                    </li>
                </ul>
            </li>

            {# Reports, Settings ... #}
            <li>
                <a href="{{ path('admin_reports') }}"
                   class="flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-medium transition-all duration-200
                          {{ app.request.get('_route') == 'admin_reports' ? 'bg-primary/10 text-primary' : 'text-white/60 hover:text-white hover:bg-white/5' }}">
                    <span class="material-symbols-outlined text-[20px]">assessment</span>
                    Rapports
                </a>
            </li>
            <li>
                <a href="{{ path('admin_settings') }}"
                   class="flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-medium transition-all duration-200
                          {{ app.request.get('_route') == 'admin_settings' ? 'bg-primary/10 text-primary' : 'text-white/60 hover:text-white hover:bg-white/5' }}">
                    <span class="material-symbols-outlined text-[20px]">settings</span>
                    Paramètres
                </a>
            </li>
        </ul>
    </nav>

    {# Merch Statistics Widget #}
    <div class="mx-3 mb-3">
        <div class="rounded-2xl border border-primary/30 bg-primary/5 p-4">
            <div class="text-[10px] font-semibold uppercase tracking-widest text-white/40 mb-2">Top Merch</div>
            <div id="top-merch" class="flex flex-col gap-1 text-sm text-white">
                {# JS will populate this #}
                <p>Chargement...</p>
            </div>
        </div>
    </div>

    {# System Status Widget #}
    <div class="mx-3 mb-3">
        <div class="rounded-2xl border border-primary/30 bg-primary/5 p-4">
            <div class="text-[10px] font-semibold uppercase tracking-widest text-white/40 mb-2">Système</div>
            <div class="flex items-center gap-2 mb-1">
                <span class="relative flex h-2 w-2">
                    <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"></span>
                    <span class="relative inline-flex rounded-full h-2 w-2 bg-green-500"></span>
                </span>
                <span class="text-sm font-semibold text-white">En ligne</span>
            </div>
            <p class="text-xs text-white/40">Tous les systèmes opérationnels</p>
        </div>
    </div>

    {# User View Link #}
    <div class="px-3 pb-2">
        <a href="{{ path('app_dashboard') }}"
           class="flex items-center justify-center gap-2 w-full py-2.5 rounded-xl border border-white/10 text-sm font-semibold text-white/70 hover:text-white hover:bg-white/5 transition-all duration-200">
            <span class="material-symbols-outlined text-[18px]">exit_to_app</span>
            Vue Utilisateur
        </a>
    </div>

    {# Logout #}
    {% if app.user %}
    <div class="px-3 pb-4">
        <a href="{{ path('app_logout') }}"
           class="flex items-center justify-center gap-2 w-full py-2.5 rounded-xl border border-red-500/20 text-sm font-semibold text-red-400/70 hover:text-red-400 hover:bg-red-500/10 transition-all duration-200">
            <span class="material-symbols-outlined text-[18px]">logout</span>
            Déconnexion
        </a>
    </div>
    {% endif %}
</aside>

{# JS to fetch top 3 merch stats #}
<script>
fetch('/api/stats/top-merch')
    .then(res => res.json())
    .then(data => {
        const container = document.getElementById('top-merch');
        container.innerHTML = '';
        data.forEach(item => {
            const div = document.createElement('div');
            div.classList.add('flex', 'items-center', 'gap-2');
            div.innerHTML = `
                <img src="${item.imageUrl}" alt="${item.name}" class="w-8 h-8 rounded">
                <span>${item.name} - ${item.totalPurchased} vendus</span>
            `;
            container.appendChild(div);
        });
    })
    .catch(err => {
        console.error('Erreur récupération top merch:', err);
    });
</script>