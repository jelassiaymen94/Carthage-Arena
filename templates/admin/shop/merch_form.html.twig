{% extends 'base.html.twig' %}

{% block title %}{{ title }} - Admin - Carthage Arena{% endblock %}

{% block body %}
<div id="mainContent" class="opacity-0 transition-opacity duration-500">
    <div class="flex min-h-screen bg-background-dark">
        {# Sidebar #}
        {% include 'admin/_sidebar.html.twig' %}

        {# Main Content Area #}
        <main class="flex-1 ml-72 overflow-y-auto h-screen">
            {# Sticky Header #}
            <header class="sticky top-0 z-30 bg-background-dark/80 backdrop-blur-xl border-b border-white/5">
                <div class="flex items-center justify-between px-8 py-4">
                    <div class="flex items-center gap-4">
                        <a href="{{ path('admin_shop') }}" class="p-2 rounded-xl bg-white/5 hover:bg-white/10 text-white/50 hover:text-white transition-all">
                            <span class="material-symbols-outlined">arrow_back</span>
                        </a>
                        <div>
                            <h1 class="text-2xl font-bold text-white">{{ title }}</h1>
                            <p class="text-sm text-white/40 mt-0.5">Gérer les produits dérivés de la boutique</p>
                        </div>
                    </div>
                </div>
            </header>

            {# Page Content #}
            <div class="p-8 max-w-3xl mx-auto">
                <div class="bg-surface-dark border border-white/5 rounded-2xl p-8 shadow-2xl">
                    {{ form_start(form, {'attr': {'class': 'space-y-6'}}) }}
                        <div class="grid grid-cols-1 gap-6">
                            <div>
                                {{ form_label(form.name, 'Nom du produit', {'label_attr': {'class': 'block text-sm font-medium text-white/60 mb-2'}}) }}
                                {{ form_widget(form.name, {'attr': {'class': 'w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-white placeholder-white/30 focus:border-primary/50 focus:ring-1 focus:ring-primary/30 outline-none transition-all'}}) }}
                                {{ form_errors(form.name) }}
                            </div>

                            <div>
                                <label for="description" class="block text-sm font-medium text-white/60 mb-2">
                                    Description
                                    <button type="button" id="generateDescriptionBtn" class="ml-2 text-xs bg-gradient-to-r from-blue-600 to-blue-500 hover:from-blue-500 hover:to-blue-400 text-white px-3 py-1 rounded-lg font-semibold transition-all inline-flex items-center gap-1">
                                        <span class="material-symbols-outlined text-sm">auto_awesome</span>
                                        Générer avec l'IA
                                    </button>
                                </label>
                                {{ form_widget(form.description, {'attr': {'class': 'w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-white placeholder-white/30 focus:border-primary/50 outline-none transition-all'}}) }}
                                {{ form_errors(form.description) }}
                            </div>

                            <div class="grid grid-cols-2 gap-6">
                                <div>
                                    {{ form_label(form.game, 'Jeu associé (optionnel)', {'label_attr': {'class': 'block text-sm font-medium text-white/60 mb-2'}}) }}
                                    {{ form_widget(form.game, {'attr': {'class': 'w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-white/70 outline-none focus:border-primary/50 form-select [&>option]:text-black'}}) }}
                                    {{ form_errors(form.game) }}
                                </div>
                                <div>
                                    {{ form_label(form.type, 'Type de produit', {'label_attr': {'class': 'block text-sm font-medium text-white/60 mb-2'}}) }}
                                    {{ form_widget(form.type, {'attr': {'class': 'w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-white/70 outline-none focus:border-primary/50 form-select [&>option]:text-black'}}) }}
                                    {{ form_errors(form.type) }}
                                </div>
                            </div>

                            <div class="grid grid-cols-2 gap-6">
                                <div>
                                    <label for="price" class="block text-sm font-medium text-white/60 mb-2">
                                        Prix (DT)
                                        <button type="button" id="calculatePriceBtn" class="ml-2 text-xs bg-gradient-to-r from-orange-600 to-orange-500 hover:from-orange-500 hover:to-orange-400 text-white px-3 py-1 rounded-lg font-semibold transition-all inline-flex items-center gap-1">
                                            <span class="material-symbols-outlined text-sm">calculate</span>
                                            Calculer
                                        </button>
                                    </label>
                                    {{ form_widget(form.price, {'attr': {'class': 'w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-white placeholder-white/30 focus:border-primary/50 outline-none transition-all'}}) }}
                                    {{ form_errors(form.price) }}
                                </div>
                                <div>
                                    {{ form_label(form.stock, 'Stock', {'label_attr': {'class': 'block text-sm font-medium text-white/60 mb-2'}}) }}
                                    {{ form_widget(form.stock, {'attr': {'class': 'w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-white placeholder-white/30 focus:border-primary/50 outline-none transition-all'}}) }}
                                    {{ form_errors(form.stock) }}
                                </div>
                            </div>

                            <div>
                                {{ form_label(form.imageUrl, 'URL de l\'image', {'label_attr': {'class': 'block text-sm font-medium text-white/60 mb-2'}}) }}
                                {{ form_widget(form.imageUrl, {'attr': {'class': 'w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-white placeholder-white/30 focus:border-primary/50 outline-none transition-all'}}) }}
                                {{ form_errors(form.imageUrl) }}
                            </div>
                        </div>

                        <div class="flex items-center gap-4 pt-6 border-t border-white/5">
                            <button type="submit" class="flex-1 inline-flex items-center justify-center gap-2 py-3.5 bg-primary hover:bg-primary/90 text-white font-bold rounded-xl transition-all shadow-lg shadow-primary/20">
                                <span class="material-symbols-outlined">save</span>
                                Enregistrer
                            </button>
                            <a href="{{ path('admin_shop') }}" class="px-8 py-3.5 bg-white/5 hover:bg-white/10 text-white/60 font-semibold rounded-xl transition-all">
                                Annuler
                            </a>
                        </div>
                    {{ form_end(form) }}
                </div>
            </div>
        </main>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const generateDescriptionBtn = document.getElementById('generateDescriptionBtn');
    const calculatePriceBtn = document.getElementById('calculatePriceBtn');
    
    // Get form field IDs
    const nameField = document.querySelector('[name="{{ form.name.vars.full_name }}"]');
    const typeField = document.querySelector('[name="{{ form.type.vars.full_name }}"]');
    const descriptionField = document.querySelector('[name="{{ form.description.vars.full_name }}"]');
    const priceField = document.querySelector('[name="{{ form.price.vars.full_name }}"]');
    const stockField = document.querySelector('[name="{{ form.stock.vars.full_name }}"]');

    // Generate Description with AI
    if (generateDescriptionBtn) {
        generateDescriptionBtn.addEventListener('click', async function(e) {
            e.preventDefault();
            
            const name = nameField.value;
            const type = typeField.value;
            const price = priceField.value;

            if (!name || !type || !price) {
                alert('Veuillez remplir le nom, le type et le prix avant de générer une description');
                return;
            }

            generateDescriptionBtn.disabled = true;
            generateDescriptionBtn.innerHTML = '<span class="material-symbols-outlined text-sm animate-spin">refresh</span> Génération...';

            try {
                const response = await fetch('{{ path("admin_api_generate_merch_description") }}', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({
                        name: name,
                        type: type,
                        price: parseInt(price),
                    }),
                });

                const data = await response.json();

                if (data.success) {
                    descriptionField.value = data.description;
                    alert('Description générée avec succès!');
                } else {
                    alert('Erreur: ' + (data.error || 'Une erreur est survenue'));
                }
            } catch (error) {
                alert('Erreur lors de la génération: ' + error.message);
            } finally {
                generateDescriptionBtn.disabled = false;
                generateDescriptionBtn.innerHTML = '<span class="material-symbols-outlined text-sm">auto_awesome</span> Générer avec l\'IA';
            }
        });
    }

    // Calculate Dynamic Price
    if (calculatePriceBtn) {
        calculatePriceBtn.addEventListener('click', async function(e) {
            e.preventDefault();
            
            const price = priceField.value;
            const stock = stockField.value;

            if (!price || !stock) {
                alert('Veuillez remplir le prix de base et le stock avant de calculer');
                return;
            }

            calculatePriceBtn.disabled = true;
            calculatePriceBtn.innerHTML = '<span class="material-symbols-outlined text-sm animate-spin">refresh</span> Calcul...';

            try {
                const response = await fetch('{{ path("admin_api_calculate_merch_price") }}', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({
                        basePrice: parseInt(price),
                        stock: parseInt(stock),
                    }),
                });

                const data = await response.json();

                if (data.success) {
                    priceField.value = data.dynamicPrice;
                    alert('Prix dynamique calculé: ' + data.dynamicPrice + ' DT');
                } else {
                    alert('Erreur: ' + (data.error || 'Une erreur est survenue'));
                }
            } catch (error) {
                alert('Erreur lors du calcul: ' + error.message);
            } finally {
                calculatePriceBtn.disabled = false;
                calculatePriceBtn.innerHTML = '<span class="material-symbols-outlined text-sm">calculate</span> Calculer';
            }
        });
    }
});
</script>
{% endblock %}
