{% extends 'base.html.twig' %}

{% block title %}Carthage Arena - Mot de passe oubli├®{% endblock %}

{% block body_class %}bg-background-dark text-white font-display min-h-screen flex items-center justify-center p-4{% endblock %}

{% block body %}
    <div
      id="mainContent"
      class="contents opacity-0 transition-opacity duration-500"
    >
      <!-- Background Effects -->
      <div class="fixed inset-0 overflow-hidden pointer-events-none">
        <div class="absolute -top-40 -left-40 w-96 h-96 bg-primary/20 rounded-full blur-3xl"></div>
        <div class="absolute -bottom-40 -right-40 w-96 h-96 bg-primary/10 rounded-full blur-3xl"></div>
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-secondary/5 rounded-full blur-3xl"></div>
      </div>

      <!-- Main Container -->
      <div class="relative z-10 w-full max-w-md">
        <!-- Logo -->
        <div class="flex flex-col items-center gap-3 mb-8">
          <img
            src="{{ asset('assets/logo.webp') }}"
            alt="Carthage Arena Logo"
            class="h-52 w-auto"
          />
          <h1 class="text-2xl font-black tracking-tight text-white uppercase italic">
            Carthage <span class="text-primary">Arena</span>
          </h1>
        </div>

        <!-- Card -->
        <div class="bg-surface-dark border border-white/5 rounded-3xl p-8 shadow-2xl">
          <div class="flex flex-col items-center gap-2 mb-6">
            <span class="material-symbols-outlined text-primary text-4xl">lock_reset</span>
            <h2 class="text-xl font-bold text-white text-center">Mot de passe oubli├®</h2>
            <p class="text-sm text-gray-400 text-center leading-relaxed">
              Entrez votre adresse e-mail et nous vous enverrons un lien pour r├®initialiser votre mot de passe.
            </p>
          </div>

          {% for message in app.flashes('success') %}
            <div class="bg-green-500/10 border border-green-500/20 rounded-xl p-4 mb-6 text-sm text-green-400 flex items-start gap-3">
              <span class="material-symbols-outlined text-[20px]">check_circle</span>
              <div>{{ message }}</div>
            </div>
          {% endfor %}

          {% for message in app.flashes('error') %}
            <div class="bg-red-500/10 border border-red-500/20 rounded-xl p-4 mb-6 text-sm text-red-400 flex items-start gap-3">
              <span class="material-symbols-outlined text-[20px]">error</span>
              <div>{{ message }}</div>
            </div>
          {% endfor %}

          <form method="post" action="{{ path('app_forgot_password') }}" class="flex flex-col gap-5" novalidate>
            <div>
              <label for="email" class="block text-sm font-medium text-gray-400 mb-2">Adresse e-mail</label>
              <input
                type="email"
                id="email"
                name="email"
                autocomplete="email"
                autofocus
                required
                class="w-full bg-[#161616] border border-white/10 rounded-xl py-3.5 px-4 text-sm text-white placeholder-gray-500 focus:border-primary focus:outline-none input-glow transition-all"
                placeholder="nom@exemple.com"
              >
            </div>

            <input type="hidden" name="_token" value="{{ csrf_token('forgot_password') }}">

            <button
              type="submit"
              class="w-full rounded-xl bg-primary py-3.5 text-sm font-bold text-white shadow-lg shadow-red-900/30 hover:bg-red-600 hover:shadow-red-600/40 hover:-translate-y-0.5 transition-all flex items-center justify-center gap-2 mt-2"
            >
              <span class="material-symbols-outlined text-[20px]">send</span>
              Envoyer le lien de r├®initialisation
            </button>
          </form>
        </div>

        <!-- Footer -->
        <p class="text-center text-xs text-gray-500 mt-6">
          Vous vous souvenez de votre mot de passe ?
          <a href="{{ path('app_login') }}" class="text-primary hover:text-white transition-colors">Se connecter</a>
        </p>
      </div>
    </div>
{% endblock %}
