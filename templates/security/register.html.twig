{% extends 'base.html.twig' %}

{% block title %}Carthage Arena - Inscription{% endblock %}

{% block body_class %}bg-background-dark text-white font-display min-h-screen flex items-center justify-center p-4{% endblock %}

{% block body %}
    <div
      id="mainContent"
      class="contents opacity-0 transition-opacity duration-500"
    >
      <!-- Background Effects -->
      <div class="fixed inset-0 overflow-hidden pointer-events-none">
        <div
          class="absolute -top-40 -left-40 w-96 h-96 bg-primary/20 rounded-full blur-3xl"
        ></div>
        <div
          class="absolute -bottom-40 -right-40 w-96 h-96 bg-primary/10 rounded-full blur-3xl"
        ></div>
        <div
          class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-secondary/5 rounded-full blur-3xl"
        ></div>
      </div>

      <!-- Main Container -->
      <div class="relative z-10 w-full max-w-md">
        <!-- Logo -->
        <div class="flex flex-col items-center gap-3 mb-8">
          <img
            src="{{ asset('assets/logo.webp') }}"
            alt="Carthage Arena Logo"
            class="h-52 w-auto"
          />
          <h1
            class="text-2xl font-black tracking-tight text-white uppercase italic"
          >
            Carthage <span class="text-primary">Arena</span>
          </h1>
        </div>

        <!-- Register Form -->
        <div class="bg-surface-dark border border-white/5 rounded-3xl p-8 shadow-2xl">

          <h2 class="text-xl font-bold text-white mb-6 text-center">Cr├®er un compte</h2>

          {# Global form errors #}
          {% for error in registrationForm.vars.errors %}
            <div class="bg-red-500/10 border border-red-500/20 rounded-xl p-4 mb-4 text-sm text-red-400 flex items-start gap-3">
              <span class="material-symbols-outlined text-[20px]">error</span>
              <div>{{ error.message }}</div>
            </div>
          {% endfor %}

          {% for message in app.flashes('error') %}
            <div class="bg-red-500/10 border border-red-500/20 rounded-xl p-4 mb-4 text-sm text-red-400 flex items-start gap-3">
              <span class="material-symbols-outlined text-[20px]">error</span>
              <div>{{ message }}</div>
            </div>
          {% endfor %}

          {{ form_start(registrationForm, {'attr': {'class': 'flex flex-col gap-5', 'novalidate': 'novalidate'}}) }}
            {# Account Type Selector #}
            <div>
              <label class="block text-sm font-medium text-gray-400 mb-3">Type de compte</label>
              <div class="flex gap-3">
                {% for child in registrationForm.accountType %}
                  <label class="flex-1 cursor-pointer">
                    <input type="radio" name="{{ child.vars.full_name }}" value="{{ child.vars.value }}" {{ child.vars.checked ? 'checked' }} class="hidden peer" id="{{ child.vars.id }}">
                    <div class="peer-checked:border-primary peer-checked:bg-primary/10 border border-white/10 rounded-xl py-3 px-4 text-center text-sm font-medium text-gray-400 peer-checked:text-primary transition-all hover:border-white/20">
                      {% if child.vars.value == 'player' %}
                        <span class="material-symbols-outlined text-[18px] align-middle mr-1">sports_esports</span>
                      {% else %}
                        <span class="material-symbols-outlined text-[18px] align-middle mr-1">gavel</span>
                      {% endif %}
                      {{ child.vars.label }}
                    </div>
                  </label>
                {% endfor %}
              </div>
            </div>

            <div>
              <label for="{{ registrationForm.username.vars.id }}" class="block text-sm font-medium text-gray-400 mb-2">Nom d'utilisateur</label>
              {{ form_widget(registrationForm.username) }}
              {% for error in registrationForm.username.vars.errors %}
                <p class="text-xs text-red-400 mt-1">{{ error.message }}</p>
              {% endfor %}
            </div>

            <div>
              <label for="{{ registrationForm.email.vars.id }}" class="block text-sm font-medium text-gray-400 mb-2">Email</label>
              {{ form_widget(registrationForm.email) }}
              {% for error in registrationForm.email.vars.errors %}
                <p class="text-xs text-red-400 mt-1">{{ error.message }}</p>
              {% endfor %}
            </div>

            {# License ID field - only visible for referees #}
            <div id="licenseIdField" class="hidden">
              <label for="{{ registrationForm.licenseId.vars.id }}" class="block text-sm font-medium text-gray-400 mb-2">Num├®ro de licence</label>
              {{ form_widget(registrationForm.licenseId) }}
              {% for error in registrationForm.licenseId.vars.errors %}
                <p class="text-xs text-red-400 mt-1">{{ error.message }}</p>
              {% endfor %}
            </div>

            <div>
              <label for="{{ registrationForm.plainPassword.first.vars.id }}" class="block text-sm font-medium text-gray-400 mb-2">Mot de passe</label>
              {{ form_widget(registrationForm.plainPassword.first) }}
              {% for error in registrationForm.plainPassword.first.vars.errors %}
                <p class="text-xs text-red-400 mt-1">{{ error.message }}</p>
              {% endfor %}
            </div>

            <div>
              <label for="{{ registrationForm.plainPassword.second.vars.id }}" class="block text-sm font-medium text-gray-400 mb-2">Confirmer le mot de passe</label>
              {{ form_widget(registrationForm.plainPassword.second) }}
              {% for error in registrationForm.plainPassword.second.vars.errors %}
                <p class="text-xs text-red-400 mt-1">{{ error.message }}</p>
              {% endfor %}
              {# Password mismatch error shows on the parent #}
              {% for error in registrationForm.plainPassword.vars.errors %}
                <p class="text-xs text-red-400 mt-1">{{ error.message }}</p>
              {% endfor %}
            </div>

            <button
              type="submit"
              class="w-full rounded-xl bg-primary py-3.5 text-sm font-bold text-white shadow-lg shadow-red-900/30 hover:bg-red-600 hover:shadow-red-600/40 hover:-translate-y-0.5 transition-all flex items-center justify-center gap-2 mt-2"
            >
              <span class="material-symbols-outlined text-[20px]">person_add</span>
              S'inscrire
            </button>
          {{ form_row(registrationForm._token) }}
          {{ form_end(registrationForm, {'render_rest': false}) }}
        </div>

        <!-- Discord OAuth -->
        <div class="mt-4 flex items-center gap-3">
          <div class="flex-1 h-px bg-white/10"></div>
          <span class="text-xs text-gray-500">ou s'inscrire avec</span>
          <div class="flex-1 h-px bg-white/10"></div>
        </div>
        <a
          href="{{ path('connect_discord') }}"
          class="mt-4 w-full flex items-center justify-center gap-3 rounded-xl bg-[#5865F2] py-3.5 text-sm font-bold text-white hover:bg-[#4752C4] hover:-translate-y-0.5 transition-all shadow-lg shadow-indigo-900/30"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 127.14 96.36" class="h-5 w-5 fill-white">
            <path d="M107.7,8.07A105.15,105.15,0,0,0,81.47,0a72.06,72.06,0,0,0-3.36,6.83A97.68,97.68,0,0,0,49,6.83,72.37,72.37,0,0,0,45.64,0,105.89,105.89,0,0,0,19.39,8.09C2.79,32.65-1.71,56.6.54,80.21h0A105.73,105.73,0,0,0,32.71,96.36,77.7,77.7,0,0,0,39.6,85.25a68.42,68.42,0,0,1-10.85-5.18c.91-.66,1.8-1.34,2.66-2a75.57,75.57,0,0,0,64.32,0c.87.71,1.76,1.39,2.66,2a68.68,68.68,0,0,1-10.87,5.19,77,77,0,0,0,6.89,11.1A105.25,105.25,0,0,0,126.6,80.22h0C129.24,52.84,122.09,29.11,107.7,8.07ZM42.45,65.69C36.18,65.69,31,60,31,53s5-12.74,11.43-12.74S54,46,53.89,53,48.84,65.69,42.45,65.69Zm42.24,0C78.41,65.69,73.25,60,73.25,53s5-12.74,11.44-12.74S96.23,46,96.12,53,91.08,65.69,84.69,65.69Z"/>
          </svg>
          S'inscrire avec Discord
        </a>

        <!-- Footer -->
        <p class="text-center text-xs text-gray-500 mt-6">
          D├®j├á un compte ?
          <a href="{{ path('app_login') }}" class="text-primary hover:text-white transition-colors"
            >Se connecter</a
          >
        </p>
      </div>
    </div>

    <script>
      document.addEventListener('DOMContentLoaded', function() {
        const radios = document.querySelectorAll('input[name="registration[accountType]"]');
        const licenseField = document.getElementById('licenseIdField');

        function toggleLicenseField() {
          const selected = document.querySelector('input[name="registration[accountType]"]:checked');
          if (selected && selected.value === 'referee') {
            licenseField.classList.remove('hidden');
          } else {
            licenseField.classList.add('hidden');
          }
        }

        radios.forEach(radio => radio.addEventListener('change', toggleLicenseField));
        toggleLicenseField();
      });
    </script>
{% endblock %}
