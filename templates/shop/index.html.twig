{% extends 'base.html.twig' %}
{% block title %}Carthage Arena - Boutique{% endblock %}

{% block body %}
<div class="flex flex-col gap-6 p-8 max-w-7xl mx-auto w-full">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
        {% for item in items %}
        <div class="group relative flex flex-col overflow-hidden rounded-2xl bg-surface-dark border border-white/5 transition-all">
            <img src="{{ item.imageUrl }}" alt="{{ item.name }}" class="w-full h-48 object-cover">
            <div class="p-4 flex flex-col gap-2">
                <h3 class="text-white font-bold">{{ item.name }}</h3>
                <span class="text-gray-400">{{ item.price }} CP</span>
                {% if item.stock <= 0 %}
                    <button class="bg-gray-500 text-white py-2 rounded cursor-not-allowed" disabled>Rupture de stock</button>
                {% elseif item.insufficient %}
                    <button class="bg-gray-500 text-white py-2 rounded cursor-not-allowed" disabled>Solde insuffisant</button>
                {% else %}
                    <button class="bg-primary text-white py-2 rounded" onclick="buyMerch('{{ item.id }}')">Acheter</button>
                {% endif %}

                {% if is_granted('ROLE_ADMIN') %}
                <div class="flex gap-2 mt-2">
                    <a href="{{ path('admin_merch_edit', {id: item.id}) }}" class="bg-yellow-500 text-white px-2 py-1 rounded">Modifier</a>
                    <button onclick="deleteMerch('{{ item.id }}')" class="bg-red-500 text-white px-2 py-1 rounded">Supprimer</button>
                </div>
                {% endif %}
            </div>
        </div>
        {% endfor %}
    </div>
</div>

<script>
function buyMerch(id) {
    fetch(`/api/purchase/${id}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ quantity: 1 })
    })
    .then(res => res.json())
    .then(data => alert(data.message || data.error))
    .catch(err => console.error(err));
}

// Admin AJAX delete
function deleteMerch(id) {
    if (!confirm('Supprimer ce merch ?')) return;
    fetch(`/admin/merch/delete/${id}`, { method: 'POST' })
        .then(() => location.reload())
        .catch(err => console.error(err));
}
</script>
{% endblock %}