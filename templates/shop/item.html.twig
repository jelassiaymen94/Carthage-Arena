{% extends 'base.html.twig' %}
{% block title %}{{ item.name }} - Boutique{% endblock %}

{% block body %}
<div class="flex flex-col max-w-5xl mx-auto p-8 gap-6">
    <div class="flex flex-col lg:flex-row gap-8">
        <img src="{{ item.imageUrl }}" alt="{{ item.name }}" class="w-full lg:w-1/2 rounded">
        <div class="flex flex-col gap-4">
            <h1 class="text-2xl font-bold">{{ item.name }}</h1>
            <p class="text-gray-400">{{ item.description }}</p>
            <span class="text-secondary font-bold text-xl">{{ item.price }} CP</span>

            <!-- Admin buttons -->
            {% if is_granted('ROLE_ADMIN') and item.type == 'merch' %}
            <div class="flex gap-2 mt-2">
                <a href="{{ path('admin_merch_edit', {id: item.id}) }}" 
                   class="bg-yellow-500 text-white py-1 px-4 rounded">Modifier</a>
                <form action="{{ path('admin_merch_delete', {id: item.id}) }}" method="post" 
                      onsubmit="return confirm('Supprimer ce merch ?');">
                    <button type="submit" class="bg-red-500 text-white py-1 px-4 rounded">Supprimer</button>
                </form>
            </div>
            {% else %}
            <!-- Regular user buy button -->
            <button 
                class="bg-primary text-white py-2 px-4 rounded mt-2"
                onclick="buyMerch('{{ item.id }}')"
            >
                Acheter
            </button>
            {% endif %}
        </div>
    </div>
</div>

<script>
function buyMerch(id) {
    fetch(`/api/purchase/${id}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ quantity: 1 })
    })
    .then(res => res.json())
    .then(data => alert(data.message || data.error))
    .catch(err => console.error(err));
}
fetch('/api/stats/top-merch')
    .then(res => res.json())
    .then(data => {
        const container = document.getElementById('top-merch');
        data.forEach(item => {
            const div = document.createElement('div');
            div.innerHTML = `<img src="${item.imageUrl}" alt="${item.name}" class="w-32 h-32">
                             <p>${item.name} - ${item.totalPurchased} sold</p>`;
            container.appendChild(div);
        });
    });

</script>
{% endblock %}