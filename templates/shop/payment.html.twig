{% extends 'base.html.twig' %}

{% block title %}Paiement - {{ skin.name }}{% endblock %}

{% block body %}
<div class="min-h-screen bg-background-dark text-white">
    <div class="container mx-auto px-4 py-8">
        <div class="max-w-2xl mx-auto">
            <h1 class="text-3xl font-bold mb-8">Paiement pour {{ skin.name }}</h1>

            <div class="bg-white/5 rounded-2xl p-6 mb-6">
                <div class="flex items-center gap-4 mb-4">
                    {% if skin.imageUrl %}
                        {% if skin.imageUrl starts with 'http' or skin.imageUrl starts with 'https' %}
                        <img src="{{ skin.imageUrl }}" alt="{{ skin.name }}" class="w-16 h-16 rounded-lg object-cover">
                        {% else %}
                        <img src="{{ asset('uploads/skins/' ~ skin.imageUrl) }}" alt="{{ skin.name }}" class="w-16 h-16 rounded-lg object-cover">
                        {% endif %}
                    {% endif %}
                    <div>
                        <h3 class="text-xl font-semibold">{{ skin.name }}</h3>
                        <p class="text-white/60">{{ skin.price }} CP</p>
                    </div>
                </div>
                <p class="text-white/60 text-sm">Solde insuffisant. Veuillez recharger votre compte ou payer par carte.</p>
            </div>

            <div class="flex gap-4">
                <a href="{{ path('app_cp_shop') }}" class="flex-1 bg-primary hover:bg-primary/80 text-white font-semibold py-3 px-6 rounded-2xl transition-colors text-center">
                    Recharger mes CP
                </a>
                <a href="{{ path('app_shop') }}" class="flex-1 bg-white/10 hover:bg-white/20 text-white font-semibold py-3 px-6 rounded-2xl transition-colors text-center">
                    Retour à la boutique
                </a>
            </div>
        </div>
    </div>
</div>
{% endblock %}
