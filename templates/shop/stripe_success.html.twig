{% extends 'base.html.twig' %}

{% block title %}Paiement Réussi — Carthage Arena{% endblock %}

{% block body %}
<div class="min-h-screen bg-background-dark flex items-center justify-center px-4 relative overflow-hidden">

  <!-- Background glow effects -->
  <div class="absolute inset-0 pointer-events-none">
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] rounded-full bg-violet-600/10 blur-3xl"></div>
    <div class="absolute top-1/4 right-1/4 w-64 h-64 rounded-full bg-indigo-600/10 blur-3xl"></div>
    <div class="absolute bottom-1/4 left-1/4 w-64 h-64 rounded-full bg-primary/10 blur-3xl"></div>
  </div>

  <!-- Animated particles -->
  <div class="absolute inset-0 pointer-events-none overflow-hidden" id="particles"></div>

  <!-- Card -->
  <div class="relative z-10 max-w-lg w-full">
    <div class="rounded-3xl bg-surface-dark border border-white/10 p-10 text-center shadow-2xl shadow-black/40 backdrop-blur-sm" id="successCard">

      <!-- Animated checkmark -->
      <div class="mx-auto mb-8 relative w-28 h-28">
        <div class="absolute inset-0 rounded-full bg-gradient-to-br from-violet-500 to-indigo-600 opacity-20 animate-ping"></div>
        <div class="absolute inset-2 rounded-full bg-gradient-to-br from-violet-600 to-indigo-700 opacity-30 animate-pulse"></div>
        <div class="relative w-full h-full rounded-full bg-gradient-to-br from-violet-500 to-indigo-600 flex items-center justify-center shadow-lg shadow-indigo-500/40">
          <svg class="w-14 h-14 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" class="checkmark-path"/>
          </svg>
        </div>
      </div>

      <!-- Title -->
      <h1 class="text-3xl font-black text-white mb-2">Paiement Réussi !</h1>
      <p class="text-gray-400 text-sm mb-8">
        Votre achat a été traité avec succès via Stripe.<br>
        L'article sera livré dans votre compte sous peu.
      </p>

      <!-- Order summary (if session data available) -->
      {% if session %}
        <div class="bg-white/5 border border-white/10 rounded-2xl p-5 mb-8 text-left">
          <p class="text-[10px] font-bold uppercase tracking-widest text-violet-400 mb-3">Récapitulatif de commande</p>

          {% for lineItem in session.items %}
            <div class="flex items-center justify-between py-2">
              <div>
                <p class="text-sm font-semibold text-white">{{ lineItem.description ?? lineItem.price.product.name ?? 'Article' }}</p>
                <p class="text-xs text-gray-500">Qté : {{ lineItem.quantity }}</p>
              </div>
              <span class="text-sm font-bold text-secondary">
                {{ (lineItem.amount_total / 100)|number_format(2, ',', ' ') }} {{ session.currency }}
              </span>
            </div>
          {% endfor %}

          <div class="border-t border-white/10 mt-3 pt-3 flex items-center justify-between">
            <span class="text-sm text-gray-400">Total payé</span>
            <span class="text-lg font-black text-white">
              {{ session.amount|number_format(2, ',', ' ') }} {{ session.currency }}
            </span>
          </div>
        </div>
      {% else %}
        <div class="bg-white/5 border border-white/10 rounded-2xl p-5 mb-8 flex items-center gap-3">
          <span class="material-symbols-outlined text-violet-400">package_2</span>
          <div class="text-left">
            <p class="text-sm font-semibold text-white">Commande confirmée</p>
            <p class="text-xs text-gray-500">Votre article a été ajouté à votre compte.</p>
          </div>
        </div>
      {% endif %}

      <!-- Info note about webhook delivery -->
      <div class="bg-indigo-500/10 border border-indigo-500/20 rounded-xl px-4 py-3 mb-8 flex items-start gap-2 text-left">
        <span class="material-symbols-outlined text-indigo-400 text-[18px] mt-0.5">info</span>
        <p class="text-xs text-indigo-300">
          La livraison est traitée automatiquement. Si l'article n'apparaît pas immédiatement dans votre historique, il sera disponible dans quelques instants.
        </p>
      </div>

      <!-- CTA buttons -->
      <div class="flex flex-col sm:flex-row gap-3">
        <a
          href="{{ path('app_profile_historique_achat') }}"
          class="flex-1 rounded-full bg-gradient-to-r from-violet-600 to-indigo-600 py-3.5 text-sm font-bold text-white hover:from-violet-500 hover:to-indigo-500 hover:-translate-y-0.5 transition-all flex items-center justify-center gap-2 shadow-lg shadow-indigo-900/30"
        >
          <span class="material-symbols-outlined text-[20px]">receipt_long</span>
          Voir mes achats
        </a>
        <a
          href="{{ path('app_shop') }}"
          class="flex-1 rounded-full bg-white/5 border border-white/10 py-3.5 text-sm font-bold text-gray-300 hover:bg-white/10 hover:text-white transition-all flex items-center justify-center gap-2"
        >
          <span class="material-symbols-outlined text-[20px]">store</span>
          Retour à la boutique
        </a>
      </div>
    </div>

    <!-- Stripe badge -->
    <div class="mt-6 flex items-center justify-center gap-2 text-gray-600 text-xs">
      <svg class="w-4 h-4" viewBox="0 0 28 28" fill="currentColor"><path d="M14 0C6.268 0 0 6.268 0 14s6.268 14 14 14 14-6.268 14-14S21.732 0 14 0zm0 25.2C7.924 25.2 2.8 20.076 2.8 14S7.924 2.8 14 2.8 25.2 7.924 25.2 14 20.076 25.2 14 25.2z"/></svg>
      Paiement sécurisé par <strong class="text-gray-400 ml-1">Stripe</strong>
    </div>
  </div>
</div>

<style>
  .checkmark-path {
    stroke-dasharray: 30;
    stroke-dashoffset: 30;
    animation: draw 0.6s ease forwards 0.4s;
  }
  @keyframes draw {
    to { stroke-dashoffset: 0; }
  }
  #successCard {
    animation: slideUp 0.5s ease forwards;
  }
  @keyframes slideUp {
    from { opacity: 0; transform: translateY(24px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  .particle {
    position: absolute;
    border-radius: 50%;
    animation: float linear infinite;
    pointer-events: none;
  }
  @keyframes float {
    0%   { transform: translateY(100vh) rotate(0deg); opacity: 1; }
    100% { transform: translateY(-100vh) rotate(720deg); opacity: 0; }
  }
</style>

<script>
// Spawn confetti particles
const particles = document.getElementById('particles');
const colors = ['#7c3aed','#4f46e5','#ec4899','#f59e0b','#10b981'];
for (let i = 0; i < 30; i++) {
  const p = document.createElement('div');
  p.className = 'particle';
  const size = Math.random() * 8 + 4;
  p.style.cssText = `
    width:${size}px; height:${size}px;
    left:${Math.random()*100}%;
    bottom:-${size}px;
    background:${colors[Math.floor(Math.random()*colors.length)]};
    opacity:${Math.random()*0.6+0.2};
    animation-duration:${Math.random()*8+6}s;
    animation-delay:${Math.random()*4}s;
  `;
  particles.appendChild(p);
}
</script>
{% endblock %}
