    </span>
    {% endfor %}
</div>

{# Ã¢â€â‚¬Ã¢â€â‚¬ Tooltip (hidden by default) Ã¢â€â‚¬Ã¢â€â‚¬ #}
<div id="cal-tooltip"
     class="hidden fixed z-50 pointer-events-none max-w-xs
            bg-[#1a1a2e] border border-purple-500/30 rounded-xl p-4 shadow-2xl text-sm text-white">
    <div class="font-bold text-base mb-2" id="tt-title"></div>
    <div class="space-y-1 text-gray-400">
        <div><span class="text-gray-500">Statut :</span> <span id="tt-status"></span></div>
        <div><span class="text-gray-500">Type :</span>   <span id="tt-type"></span></div>
        <div><span class="text-gray-500">Ãƒâ€°quipes :</span><span id="tt-teams"></span></div>
        <div><span class="text-gray-500">Prize :</span>  <span id="tt-prize"></span> DT</div>
    </div>
</div>

{# Ã¢â€â‚¬Ã¢â€â‚¬ Calendar Container Ã¢â€â‚¬Ã¢â€â‚¬ #}
<div class="bg-[#161616] border border-gray-800 rounded-xl shadow-lg p-6">
    <div id="calendar"></div>
</div>

{# Ã¢â€â‚¬Ã¢â€â‚¬ FullCalendar JS Ã¢â€â‚¬Ã¢â€â‚¬ #}
<script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.14/index.global.min.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function () {
    const tooltip = document.getElementById('cal-tooltip');
    const ttTitle  = document.getElementById('tt-title');
    const ttStatus = document.getElementById('tt-status');
    const ttType   = document.getElementById('tt-type');
    const ttTeams  = document.getElementById('tt-teams');
    const ttPrize  = document.getElementById('tt-prize');

    const calendar = new FullCalendar.Calendar(document.getElementById('calendar'), {
        locale: 'fr',
        initialView: 'dayGridMonth',
        headerToolbar: {
            left:   'prev,next today',
            center: 'title',
            right:  'dayGridMonth,dayGridWeek,listMonth'
        },
        buttonText: {
            today:     'Aujourd\'hui',
            month:     'Mois',
            week:      'Semaine',
            list:      'Liste'
        },
        events: '{{ path('app_tournoi_calendar_events') }}',
        eventDisplay: 'block',
        dayMaxEvents: 3,

        // Navigate to show page on click
        eventClick: function (info) {
            info.jsEvent.preventDefault();
            if (info.event.url) {
                window.location.href = info.event.url;
            }
        },

        // Tooltip on hover
        eventMouseEnter: function (info) {
            const p = info.event.extendedProps;
            ttTitle.textContent  = info.event.title;
            ttStatus.textContent = p.status || 'Ã¢â‚¬â€';
            ttType.textContent   = p.type   || 'Ã¢â‚¬â€';
            ttTeams.textContent  = p.teams  || 'Ã¢â‚¬â€';
            ttPrize.textContent  = p.prize  || '0';
            tooltip.classList.remove('hidden');
        },
        eventMouseLeave: function () {
            tooltip.classList.add('hidden');
        },

        // FullCalendar dark theme overrides via custom class names
        themeSystem: 'standard',
    });

    calendar.render();

    // Follow cursor for tooltip
    document.addEventListener('mousemove', function (e) {
        tooltip.style.left = (e.clientX + 14) + 'px';
        tooltip.style.top  = (e.clientY + 14) + 'px';
    });
});
</script>

{# Ã¢â€â‚¬Ã¢â€â‚¬ Dark theme CSS overrides for FullCalendar Ã¢â€â‚¬Ã¢â€â‚¬ #}
