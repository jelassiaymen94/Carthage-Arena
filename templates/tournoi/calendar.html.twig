{# Ã¢â€â‚¬Ã¢â€â‚¬ Legend Ã¢â€â‚¬Ã¢â€â‚¬ #}
<div class="flex flex-wrap gap-3 mb-4">
    {% for label, color in {
        'Ãƒâ‚¬ venir':    '#3b82f6',
        'En cours':   '#22c55e',
        'TerminÃƒÂ©':    '#6b7280',
        'AnnulÃƒÂ©':     '#ef4444'
    } %}
    <span class="flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-semibold text-white"
